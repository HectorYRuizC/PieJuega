export GOOGLE_APPLICATION_CREDENTIALS="$HOME/.config/piejuega/firebase-admin.json"
export FIREBASE_PROJECT_ID="your-firebase-project-id"
export CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
export CLOUDINARY_API_KEY="your-cloudinary-api-key"
export CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# Secretos del backend (application-dev.properties los lee con fallback).
# En producción: definir SIEMPRE JWT_SECRET y MAIL_APP_PASSWORD.
export JWT_SECRET="generate-a-long-random-secret"
export MAIL_USERNAME="your-smtp-user@gmail.com"
export MAIL_APP_PASSWORD="your-smtp-app-password"
export SPRING_PROFILES_ACTIVE="dev"
